[
  {
    "id": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [{ "header": "user-agent", "operation": "set", "value": "Mozilla/5.0 (Linux; Android 10; SM-G975F) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/107.0.0.0 Mobile Safari/537.36" }]
    },
    "condition": {
      "urlFilter": "||youtube.com",
      "excludedRequestDomains": ["music.youtube.com", "studio.youtube.com"],
      "resourceTypes": ["main_frame", "sub_frame", "script"]
    }
  },
  {
    "id": 2,
    "action": {
      "type": "redirect",
      "redirect": { "transform": { "queryTransform": { "removeParams": ["app"] } } }
    },
    "condition": {
      "regexFilter": "^https?://([a-z]+\\.)?youtube\\.com/.*[?&]app=",
      "excludedRequestDomains": ["music.youtube.com", "studio.youtube.com"],
      "resourceTypes": ["main_frame"]
    }
  }
]
